# Compose runs without a .env file by using development defaults.
# Replace this secret outside local demonstrations.
APP_SESSION_SECRET=replace-with-a-random-secret-at-least-32-bytes
APP_SESSION_SECURE=false
MYSQL_DATABASE=material_studio
MYSQL_USER=material
MYSQL_PASSWORD=material_dev
MYSQL_ROOT_PASSWORD=root_dev
DB_IMAGE=mysql:8.4
